{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"[skip ci]\"*) exit 0 ;; esac; if [ \"$VERCEL_ENV\" = \"preview\" ]; then exit 0; fi; exit 1",
  "redirects": [
    {
      "source": "/",
      "destination": "https://blode.co/moon",
      "has": [
        {
          "type": "host",
          "value": "moon.blode.co"
        }
      ],
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://blode.co/moon/:path*",
      "has": [
        {
          "type": "host",
          "value": "moon.blode.co"
        }
      ],
      "permanent": true
    }
  ]
}
